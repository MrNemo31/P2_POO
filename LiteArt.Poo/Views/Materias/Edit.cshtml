@model MateriaFormularioViewModel

@{
    ViewData["Title"] = "Editar Matéria";
}

@section Styles {
    <link rel="stylesheet" href="~/css/materia-formulario.css" asp-append-version="true" />
}

<h1>Editar Matéria</h1>

<form asp-controller="Materia" asp-action="Edit" method="post" class="materia-form">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>

    <input type="hidden" asp-for="IdMateria" />

    <div class="materia-field">
        <label asp-for="Nome" class="form-label">
            Nome da matéria
        </label>
        <input asp-for="Nome" class="form-control" maxlength="100" required />
        <span asp-validation-for="Nome"></span>
    </div>

    <div class="materia-field">
        <label asp-for="Descricao" class="form-label">
            Descrição
        </label>
        <textarea asp-for="Descricao" class="form-control" rows="5"></textarea>
    </div>

    <div class="materia-field">
        <label asp-for="IdAdministrador" class="form-label">
            ID do administrador
        </label>
        <input asp-for="IdAdministrador" type="number"
               class="form-control" min="1" required />
            <span asp-validation-for="IdAdministrador"></span>
    </div>

    <div class="materia-actions">
        <button type="submit" class="button button-primary">
            Salvar alterações
        </button>

        <a asp-controller="Materia" asp-action="Index"
           class="button button-secondary">
            Cancelar
        </a>

    </div>
</form>
