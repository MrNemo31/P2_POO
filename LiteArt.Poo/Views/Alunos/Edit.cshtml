@model AlunoFormularioViewModel

@{
    ViewData["Title"] = "Editar Aluno";
}

<h1>Editar aluno</h1>

<form asp-controller="Aluno" asp-action="Edit" method="post">
    <div asp-validation-summary="All" role="alert"></div>

    <input type="hidden" asp-for="IdAluno" />

    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>

        <input asp-for="Nome"
               class="form-control"
               placeholder="Digite o nome do aluno"
               maxlength="100"
               required />
        <span asp-validation-for="Nome"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-mail</label>

        <input asp-for="Email"
               type="email"
               class="form-control"
               placeholder="Digite o e-mail do aluno"
               maxlength="150"
               required />
        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar alterações
    </button>

    <a asp-controller="Aluno"
       asp-action="Index"
       class="btn btn-secondary">
        Voltar
    </a>

</form>
