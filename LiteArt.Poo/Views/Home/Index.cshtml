@{
    ViewData["Title"] = "Início";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}
<section class="home-hero" aria-labelledby="titulo-inicio">
    <div class="hero-copy">
        <p class="eyebrow">PAINEL ADMINISTRATIVO</p>
        <h1 id="titulo-inicio">Gestão de conteúdo.<br /><em>Questões em ordem.</em></h1>
        <p class="lead">Cadastre e revise questões, organize as matérias e consulte as tentativas dos alunos em um só lugar.</p>
        <div class="hero-actions">
            <a class="button button-primary" href="@Url.Content("~/Questoes")">Gerenciar questões <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="@Url.Content("~/Materia")">Listar matérias <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="@Url.Content("~/Aluno")">Listar alunos <span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href="@Url.Content("~/Administrador")">Listar administradores <span aria-hidden="true">↗</span></a>
        </div>
        <p class="hero-footnote">Administração do portal LiteArt POO.</p>
    </div>
    <div class="hero-art" aria-hidden="true">
        <span class="art-spark spark-one">✦</span><span class="art-spark spark-two">✦</span>
        <div class="art-orbit"></div>
        <div class="book"><div class="book-left"><span></span><span></span><span></span><span></span></div><div class="book-right"><span></span><span></span><span></span><span></span></div></div>
        <span class="art-note">Conteúdo bem organizado.</span><span class="art-check">✓</span>
    </div>
</section>
<section aria-labelledby="titulo-caminhos" class="home-paths">
    <div class="section-heading"><div><p class="eyebrow">ÁREA DE ADMINISTRAÇÃO</p><h2 id="titulo-caminhos">Ferramentas de gerenciamento</h2></div><span class="muted">Organize o banco e confira a apresentação das questões.</span></div>
    <div class="path-grid">
        <a class="path-card" href="@Url.Content("~/Questoes")"><span class="card-icon" aria-hidden="true">▤</span><span class="path-number">01 / GERENCIAR</span><h3>Banco de questões</h3><p>Consulte o conteúdo cadastrado, revise enunciados e organize as matérias e os gabaritos.</p><span class="card-link">Gerenciar questões <span aria-hidden="true">↗</span></span></a>
        <a class="path-card" href="@Url.Content("~/Estudo")"><span class="card-icon" aria-hidden="true">✎</span><span class="path-number">02 / CONFERIR</span><h3>Resolução de questões</h3><p>Acesse os enunciados, envie respostas e confira o resultado das tentativas.</p><span class="card-link">Resolver questões <span aria-hidden="true">↗</span></span></a>
    </div>
</section>
